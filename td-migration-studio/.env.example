# Copy to .env to enable REAL connectors. Leave blank to stay fully simulated/offline.

# ---- Source: real Teradata (default: emulated) ----
TD_MODE=emulated
# TD_HOST=
# TD_USER=
# TD_PASSWORD=
# TD_DATABASE=RETAIL_DW
# TD_LOGMECH=TD2

# ---- Google BigQuery (free sandbox works: no billing account needed) ----
# BIGQUERY_PROJECT=
# BIGQUERY_LOCATION=US
# GOOGLE_APPLICATION_CREDENTIALS=/data/creds/bq-service-account.json

# ---- Amazon Redshift ----
# REDSHIFT_HOST=
# REDSHIFT_PORT=5439
# REDSHIFT_DATABASE=dev
# REDSHIFT_USER=
# REDSHIFT_PASSWORD=
# REDSHIFT_S3_BUCKET=
# REDSHIFT_IAM_ROLE_ARN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ---- Azure Synapse (dedicated SQL pool) ----
# SYNAPSE_SERVER=myws.sql.azuresynapse.net
# SYNAPSE_DATABASE=
# SYNAPSE_USER=
# SYNAPSE_PASSWORD=
# SYNAPSE_ADLS_ACCOUNT=
# SYNAPSE_ADLS_CONTAINER=
# SYNAPSE_ADLS_SAS=
